{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The widget only needs its own commands plus the tray/drag/notification surface.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:event:default",
    "notification:default",
    "autostart:default"
  ]
}