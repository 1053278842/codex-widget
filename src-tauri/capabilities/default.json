{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The widget only needs its own commands plus the tray/drag/notification surface. The overlay window needs event + invoke access to play its sequence.",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:event:default",
    "notification:default",
    "autostart:default"
  ]
}